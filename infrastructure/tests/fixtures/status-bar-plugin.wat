(component
  (type $types (instance
    (type $optional-string (option string))
    (type $view (record
      (field "session" string)
      (field "worktree-name" string)
      (field "worktree-path" string)
      (field "repository-path" $optional-string)
      (field "agent-type" string)
      (field "agent-task" $optional-string)
      (field "agent-model" $optional-string)
    ))
    (export "active-view" (type (eq $view)))
    (type $field (record (field "name" string) (field "value" string)))
    (export "field" (type (eq $field)))
  ))
  (import "power:status-bar/types@0.1.0" (instance $types (type $types)))
  (alias export $types "active-view" (type $active-view))
  (alias export $types "field" (type $field))
  (type $fields (list $field))

  (core module $plugin
    (memory (export "memory") 1)
    ;; A single name/value record. The plugin uses the session string as the value.
    (data (i32.const 0) "\10\00\00\00\01\00\00\00")
    (data (i32.const 16) "\20\00\00\00\07\00\00\00")
    (data (i32.const 32) "fixture")
    (global $next (mut i32) (i32.const 256))
    (func (export "realloc") (param i32 i32 i32) (param $size i32) (result i32)
      (local $start i32)
      (local.set $start (global.get $next))
      (global.set $next (i32.and (i32.add (i32.add (local.get $start) (local.get $size)) (i32.const 7)) (i32.const -8)))
      (local.get $start)
    )
    (func (export "handle") (param $view i32) (result i32)
      (i32.store (i32.const 24) (i32.load (local.get $view)))
      (i32.store (i32.const 28) (i32.load offset=4 (local.get $view)))
      (i32.const 0)
    )
  )
  (core instance $instance (instantiate $plugin))
  (alias core export $instance "memory" (core memory $memory))
  (alias core export $instance "realloc" (core func $realloc))
  (alias core export $instance "handle" (core func $handle))
  (type $handler (func (param "view" $active-view) (result $fields)))
  (func (export "on-active-view") (type $handler)
    (canon lift (core func $handle) (memory $memory) (realloc $realloc))
  )
)
